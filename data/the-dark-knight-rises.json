  "themes": [
    {
      "id": "order-and-chaos",
      "name": "Order and chaos",
      "scene": "Bane seals Gotham off, lets its wealthy be dragged from their homes and put before improvised courts where the crowd's noise counts for more than evidence. The city's institutions are not destroyed by one blow but taken over and turned inside out.",
      "source": "https://en.wikipedia.org/wiki/The_Dark_Knight_Rises",
      "new": false
    },
    {
      "id": "sacrifice",
      "name": "Sacrifice",
      "scene": "Batman flies the bomb out over the bay, away from the city, seemingly giving up his life to save it. Gordon later reads from Dickens at a funeral for a man the city thinks it has lost.",
