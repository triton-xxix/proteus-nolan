      "new": false
    },
    {
      "id": "fear",
      "name": "Fear",
      "scene": "Bruce, broken and imprisoned in a deep pit, is told that the way out requires climbing without a safety rope, because fear is what lets a person leap. Only when he lets go of the safeguard does he make the jump.",
      "source": null,
      "unverified": true,
