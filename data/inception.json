  "themes": [
    {
      "id": "guilt",
      "name": "Guilt",
      "scene": "Cobb's dead wife appears inside the dreams he builds and keeps wrecking the jobs. She reads as a projection of what he cannot forgive himself for, which is why she intrudes exactly when the team needs a clean run.",
      "source": null,
      "unverified": true,
      "new": false
    },
    {
      "id": "grief",
      "name": "Grief",
      "scene": "Cobb cannot go home, and the whole job is a way to buy back his old life and see his children again. A loss drives every decision he makes in the film.",
      "source": null,
      "unverified": true,
      "new": false
    },
    {
      "id": "memory",
      "name": "Memory",
      "scene": "Nolan has said the heist framing was too light for a story about dream and memory, so Cobb was given an emotional wound to carry. The dreams are built from remembered places and people, which is how the past leaks into the job.",
      "source": "https://www.slashfilm.com/christopher-nolan-talks-inception/",
      "new": false
    },
    {
      "id": "time",
      "name": "Time",
      "scene": "During the climax the film cuts among several dream levels at once, each running at its own speed, while a van falls in slow motion on the topmost one. The deadlines tie the clocks together.",
      "source": "https://www.davidbordwell.net/blog/?p=9770",
      "new": false
    },
    {
      "id": "deception",
      "name": "Deception",
      "scene": "The final shot cuts away as a spinning top seems to wobble, leaving the viewer unsure whether the scene is real. The film plays tricks on its characters and its audience in the same move.",
      "source": null,
      "unverified": true,
      "new": false
    }
  ],
  "inspirations": [
    {
      "claim": "Nolan says he has been fascinated by dreams since childhood, which is the root of the film's idea.",
      "who": "Christopher Nolan",
      "quote": "I've been fascinated by dreams my whole life",
      "source": "https://slashfilm.com/1098191/a-lifelong-fascination-led-christopher-nolan-to-inception"
    },
    {
      "claim": "Nolan first wrote it as a conventional heist, then decided that was too shallow for a story about dream and memory, and raised the emotional stakes with help from conversations with Leonardo DiCaprio.",
