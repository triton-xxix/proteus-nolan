  "themes": [
    {
      "id": "obsession",
      "name": "Obsession",
      "scene": "Angier, determined to beat his rival's teleportation trick, takes a machine from Tesla and stakes his own life on it. Night after night he steps into the apparatus and lets the show continue, whatever it does to him. The wish to win has overtaken every other reason.",
      "source": "https://en.wikipedia.org/wiki/The_Prestige_(film)",
      "new": false
    },
    {
      "id": "deception",
      "name": "Deception",
      "scene": "The film closes on the revelation that 'Borden' was two identical men sharing one life. Looking back, the secret was in front of us the whole time while the story pointed our eyes at the hands, the diaries and the stage.",
      "source": "https://www.salon.com/2006/10/20/nolan_2/",
      "new": false
    },
    {
      "id": "duality",
      "name": "Duality",
      "scene": "The two magicians are built as mirrors: one a hands-on working-class craftsman, the other a polished showman. Neither is allowed to be simply the hero or the villain, and the twin secret makes the doubling literal.",
      "source": "https://en.wikipedia.org/wiki/The_Prestige_(film)",
      "new": false
    },
    {
      "id": "sacrifice",
      "name": "Sacrifice",
      "scene": "Each trick demands something real in return. Angier's solution to the Transported Man leaves him drowning in a tank beneath his own stage while the audience applauds above, and the film asks what a person owes to art that they cannot get back.",
      "source": "https://en.wikipedia.org/wiki/The_Prestige_(film)",
      "new": false
    },
    {
      "id": "the-machine",
      "name": "The machine",
      "scene": "Angier travels to meet Nikola Tesla, who builds him a device that duplicates whatever stands in it. The invention works better than anyone wants, and the film sets it beside the real Tesla and Edison rivalry as a second war running behind the first.",
      "source": "https://en.wikipedia.org/wiki/The_Prestige_(film)",
      "new": false
    }
  ],
  "inspirations": [
    {
      "claim": "The film adapts Christopher Priest's 1995 novel. Producer Valerie Dean brought the book to Nolan, who read it in London and passed it to Jonathan; the brothers then spent about five years on the script.",
      "who": "Christopher Nolan, Jonathan Nolan",
      "quote": "",
      "source": "https://en.wikipedia.org/wiki/The_Prestige_(film)"
    },
    {
      "claim": "Nolan said the script borrows the three-act shape of a magic trick (the pledge, the turn, the prestige), and was built to steer the audience away from planted clues.",
      "who": "Christopher Nolan",
      "quote": "",
      "source": "https://www.salon.com/2006/10/20/nolan_2/"
    },
    {
      "claim": "Nolan argued that the audience cooperates in being deceived: viewers know it is an illusion and want to be taken somewhere surprising.",
      "who": "Christopher Nolan",
      "quote": "The trick that you play on the audience is played with the audience's collaboration.",
      "source": "https://www.salon.com/2006/10/20/nolan_2/"
    },
    {
      "claim": "Nolan told Variety the film depended on journals within journals and stories within stories, which echoed the novel's literary devices and were hard to carry into cinema (as reported by Wikipedia).",
      "who": "Christopher Nolan",
      "quote": "",
      "source": "https://en.wikipedia.org/wiki/The_Prestige_(film)"
    },
    {
      "claim": "Tom Shone's book The Nolan Variations (2020) may discuss further influences on the film. Not fetched, so nothing is claimed from it.",
