  "themes": [
    {
      "id": "time",
      "name": "Time",
      "scene": "After a brief landing on a water world near the black hole, the crew return to their ship to find that 23 years have passed for the man left aboard. The short trip has quietly cost them more than two decades.",
      "source": "https://en.wikipedia.org/wiki/Interstellar_(film)",
      "new": false
    },
    {
      "id": "fathers-and-children",
      "name": "Fathers and children",
      "scene": "Cooper has to leave his daughter behind for the mission. Years later he watches message after message from his grown children pile up on the ship, each one older than the last.",
      "source": null,
      "unverified": true,
      "new": false
    },
    {
      "id": "the-machine",
      "name": "The machine",
      "scene": "TARS, a blocky robot built from sliding slabs rather than a human shape, works alongside the crew with an adjustable honesty setting. Nolan has described the robot as a friendly counterpart to a famous earlier film computer.",
      "source": "https://www.nhpr.org/2014-11-07/christopher-nolan-on-blending-reality-into-fantasy-in-interstellar",
      "new": false
    },
    {
      "id": "sacrifice",
      "name": "Sacrifice",
      "scene": "Cooper detaches his module and falls toward the black hole so that the rest of the crew has enough momentum to continue the mission.",
      "source": null,
      "unverified": true,
      "new": false
    },
    {
      "id": "faith",
      "name": "Faith",
      "scene": "Brand argues for travelling to a distant planet because of love for someone she may never see again, and says that feeling might point to something the characters cannot measure.",
      "source": null,
