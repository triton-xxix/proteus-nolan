  "themes": [
    {
      "id": "duty",
      "name": "Duty",
      "scene": "A pilot keeps flying on with a failing fuel gauge, rationing what he has left so he can keep protecting the ships below. His job is the only thing he is thinking about, and he treats the cost as arithmetic.",
      "source": null,
      "new": false,
      "unverified": true
    },
    {
      "id": "fear",
      "name": "Fear",
      "scene": "Soldiers on the beach and a torpedoed ship crowd into a hold, and every sound outside becomes a threat. The film keeps the enemy off screen so the dread comes from waiting, not from seeing.",
      "source": null,
      "new": false,
      "unverified": true
    },
    {
      "id": "time",
      "name": "Time",
      "scene": "The hour in the air, the day at sea and the week on the beach are cut together as if they happen at once, with a ticking score pushing all three forward. The audience feels the clock without being told which one it is watching.",
      "source": "https://en.wikipedia.org/wiki/Dunkirk_(2017_film)",
      "new": false
    },
    {
      "id": "sacrifice",
      "name": "Sacrifice",
      "scene": "A civilian skipper takes his small boat across the Channel to pick up strangers, knowing the crossing is dangerous. His small act is one of many that together change the outcome.",
      "source": "https://www.denofgeek.com/movies/dunkirk-christopher-nolans-immersive-war-experience/",
      "new": false
    }
  ],
  "inspirations": [
    {
      "claim": "Nolan wanted to apply the snowballing momentum of the third act of his earlier films across the whole film, using a new rhythm and fewer conventional dramatic devices.",
      "who": "Nolan",
      "quote": "I wanted to experiment with a new rhythm.",
      "source": "https://gulfnews.com/amp/story/entertainment%2Fhollywood%2Fdunkirk-is-an-experiment-in-a-new-rhythm-says-nolan-1.2064091"
    },
    {
      "claim": "He treated the story as sustained suspense rather than horror, citing The Wages of Fear and Mad Max: Fury Road as models.",
      "who": "Nolan",
      "source": "https://gulfnews.com/amp/story/entertainment%2Fhollywood%2Fdunkirk-is-an-experiment-in-a-new-rhythm-says-nolan-1.2064091"
    },
    {
      "claim": "The crew studied Hitchcock, David Lean's landscapes and the beach imagery of Ryan's Daughter, alongside Clouzot's suspense language.",
      "who": "Nolan",
      "source": "https://www.denofgeek.com/movies/dunkirk-christopher-nolans-immersive-war-experience/"
    },
    {
      "claim": "He conceived the idea in the mid-1990s after sailing the Channel with Emma Thomas, and she persuaded him to write a script rather than improvise.",
      "who": "Nolan and Emma Thomas",
      "source": "https://en.wikipedia.org/wiki/Dunkirk_(2017_film)"
    }
  ],
