  "themes": [
    {
      "id": "order-and-chaos",
      "name": "Order and chaos",
      "scene": "The Joker sets two ferries, one of civilians and one of prisoners, each holding the trigger for the other. He expects ordinary people to choose their own survival. Neither boat acts, and his bet that order is only a thin skin over panic fails.",
      "source": "https://en.wikipedia.org/wiki/The_Dark_Knight_(film)",
      "new": false
    },
    {
      "id": "duality",
      "name": "Duality",
      "scene": "After Rachel's death and his own burns, Harvey Dent turns from the city's clean-handed prosecutor into Two-Face, handing out fates by coin. Nolan has said Dent shares a duality with Batman, which is why he is central.",
      "source": "https://en.wikipedia.org/wiki/The_Dark_Knight_(film)",
      "new": false
    },
    {
      "id": "sacrifice",
      "name": "Sacrifice",
      "scene": "At the end Batman takes the blame for Dent's crimes so Gotham can keep believing in its hero. He accepts becoming hunted so the city's hope survives, and Gordon lets the lie stand.",
      "source": "https://en.wikipedia.org/wiki/The_Dark_Knight_(film)",
      "new": false
    },
    {
      "id": "fear",
      "name": "Fear",
      "scene": "Nolan described the film as reflecting his fear of anarchy. The Joker works through terror: he sends videos and public threats, and kills people unless Batman unmasks, so the whole city is made to live by his deadlines.",
      "source": "https://en.wikipedia.org/wiki/The_Dark_Knight_(film)",
      "new": false
    },
    {
      "id": "deception",
      "name": "Deception",
      "scene": "The Joker lets his own plan look chaotic while it is carefully staged, including getting himself caught so he can reach Gotham's police station. Batman and Gordon meanwhile fake Gordon's death to draw the Joker out.",
      "source": null,
      "unverified": true,
      "new": false
    }
  ],
